          "value": "Technicians",
          "mode": "name"
        },
        "options": {}
      }
    },
    {
      "id": "47898b90-72f1-4629-98a2-8d7d25dbd3d9",
      "name": "Match Available Technician",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "jsCode": "const request=$('Read Dispatch Input').first().json;\nif(!request.ticket_id||!request.category)return [{json:{success:false,error:'ticket_id and category required'}}];\nif(request.priority==='Critical')return [{json:{success:false,requires_human_review:true,message:'Critical incidents must be manually approved before dispatch'}}];\nconst technicians=$input.all().map(i=>i.json);\nconst matches=technicians.filter(t=>String(t.Skills??'').toLowerCase().split(',').map(x=>x.trim()).includes(request.category.toLowerCase())&&String(t.Availability??'').toLowerCase()==='available'&&Number(t.Active_Jobs??0)<Number(t.Max_Jobs??1)).sort((a,b)=>Number(a.Active_Jobs??0)-Number(b.Active_Jobs??0));\nif(!matches.length)return [{json:{success:false,ticket_id:request.ticket_id,message:'No available matching technician; manual assignment required'}}];\nconst t=matches[0];return [{json:{success:true,ticket_id:request.ticket_id,technician_id:t.Technician_ID,technician_name:t.Technician_Name,technician_email:t.Email??'',dispatch_status:'Awaiting Confirmation',assigned_date:new Date().toISOString(),message:'Suggested technician; confirm assignment and update ticket manually'}}];"
      }
    },
    {
      "id": "36ae1e89-a3a3-47e4-ab41-96e7d45eac48",
      "name": "API Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1180,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
