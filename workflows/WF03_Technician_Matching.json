      "name": "Read Dispatch Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        430,
        300
      ],
      "parameters": {
        "jsCode": "const b=$json.body??$json;return [{json:{ticket_id:String(b.ticket_id??''),category:String(b.category??''),priority:String(b.priority??'Medium')}}];"
      }
    },
    {
      "id": "a54d9001-d772-436e-81a9-286dfa4da3f7",
      "name": "Read Technicians",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
