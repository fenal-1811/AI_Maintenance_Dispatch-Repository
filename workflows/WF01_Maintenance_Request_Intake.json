{
  "name": "WF01_Maintenance_Request_Intake",
  "nodes": [
    {
      "id": "28e6f427-f60c-4803-a5e5-598eb7abef9a",
      "name": "Request Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "maintenance-request",
