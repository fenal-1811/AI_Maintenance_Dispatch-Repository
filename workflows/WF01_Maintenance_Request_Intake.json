    {
      "id": "72178f00-9558-42d6-8fef-7cb4a2eea41a",
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        450,
        300
      ],
      "parameters": {
        "jsCode": "const b=$json.body??$json;\nconst required=['employee_name','employee_email','issue_description','location'];\nconst missing=required.filter(k=>!String(b[k]??'').trim());\nif(missing.length) return [{json:{success:false,error:'Missing fields',missing}}];\nif(!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(String(b.employee_email))) return [{json:{success:false,error:'Invalid email'}}];\nconst issue=String(b.issue_description).trim().slice(0,3000);\nconst text=issue.toLowerCase();\nconst category=/air condition|\\bac\\b|cooling|hvac/.test(text)?'HVAC':/leak|water|pipe|drain/.test(text)?'Plumbing':/power|electrical|wire|socket|spark/.test(text)?'Electrical':/computer|printer|network|wifi/.test(text)?'IT Equipment':'General Maintenance';\nconst critical=/fire|smoke|gas leak|electrocution|exposed live wire|collapse/.test(text);\nconst priority=critical?'Critical':/flood|burst pipe|no power|urgent/.test(text)?'High':'Medium';\nreturn [{json:{success:true,ticket_id:'MNT-'+Date.now()+'-'+Math.floor(Math.random()*10000),employee_name:String(b.employee_name).trim(),employee_email:String(b.employee_email).trim(),phone:String(b.phone??''),issue_description:issue,location:String(b.location).trim(),category,priority,status:critical?'Escalated':'Pending',assigned_technician_id:'',created_at:new Date().toISOString(),updated_at:new Date().toISOString(),resolution_notes:'',requires_human_review:critical}}];"
      }
    },
    {
      "id": "590c0eb7-75d4-4909-87cf-3ede6a96f75d",
      "name": "Valid Request?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "991e511c-242a-43c6-80c2-245217dcc30f",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "c4459aa7-a316-46af-8262-5f8255c14b57",
      "name": "Save Maintenance Ticket",
      "type": "n8n-nodes-base.googleSheets",
