    {
      "id": "6df77eb4-8961-4324-af97-13554c63bd5b",
      "name": "Validate Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ],
      "parameters": {
        "jsCode": "const b=$json.body??$json;const allowed=['Pending','Analyzing','Awaiting Approval','Assigned','In Progress','On Hold','Completed','Rejected','Escalated'];\nif(!b.ticket_id||!allowed.includes(b.status))return [{json:{success:false,error:'Valid ticket_id and status required'}}];\nreturn [{json:{success:true,ticket_id:String(b.ticket_id),status:b.status,resolution_notes:String(b.resolution_notes??''),updated_at:new Date().toISOString(),message:'Validated. Update the matching Google Sheets row through an authenticated admin workflow.'}}];"
      }
    },
    {
      "id": "b29b119c-2d91-480e-a20d-e48f53d53665",
      "name": "API Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        820,
        300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Status Webhook": {
